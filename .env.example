# Copie para .env.local e preencha. NUNCA commite .env.local.

# Supabase — público, vai para o browser
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase — SEGREDO. Só server, nunca em arquivo "use client".
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: chave do MCP context7 (docs de bibliotecas). Sem ela, funciona com rate limit.
CONTEXT7_API_KEY=
