# Copie para .env.local e preencha. .env.local nunca é commitado.
# Em desenvolvimento local, `npx supabase start` imprime a URL e as chaves.

# --- Público: vai para o browser. Nada de segredo aqui. ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-aqui
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Servidor: segredo. Nunca prefixe com NEXT_PUBLIC_. ---
# Ignora RLS. Lida apenas por src/server/admin/.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# --- Opcionais ---
# Token que o Power BI manda no header Authorization (mínimo 24 caracteres).
POWERBI_API_TOKEN=
# Sugestão de mapeamento de colunas na importação. Sem a chave, vale só a
# detecção por apelidos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
